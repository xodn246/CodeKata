#include <string>
#include <vector>
#include <algorithm>

using namespace std;

vector<int> solution(int k, vector<int> score) {
    vector<int> answer;
    vector<int> HOF;
    
    for(int i = 0 ; i < score.size(); ++i)
    {
        HOF.push_back(score[i]);
        sort(HOF.begin(), HOF.end(), greater());
        
        if(HOF.size() > k)
        {
            HOF.pop_back();
        }
        
        answer.push_back(HOF[HOF.size() - 1]);
    }
    
    return answer;
}
